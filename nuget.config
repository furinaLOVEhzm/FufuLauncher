<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 本机网络链路对官方源 api.nuget.org 存在中间层证书替换(返回 Let's Encrypt 证书),
         导致 SSL 校验失败(NU1301)。改用华为云镜像源还原;官方源恢复后可自行改回。 -->
    <clear />
    <add key="huaweicloud" value="https://mirrors.huaweicloud.com/repository/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
