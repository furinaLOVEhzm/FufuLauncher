<?xml version="1.0" encoding="utf-8"?>
<!--
  FufuLauncher - 发布配置(严格 .NET 10 自包含)
  Copyright © FufuLauncher

  一键发布命令(在项目根目录执行):
    dotnet publish src\FufuLauncher\FufuLauncher.csproj /p:PublishProfile=FufuRelease

  发布前若旧 exe 被占用,先在任务管理器结束 FufuLauncher 进程。

  部署规则:
  - 自包含/松散部署/不裁剪等硬约束已写死在工程层 FufuLauncher.csproj,
    任何构建产物都不依赖目标机安装 .NET,干净机器双击直接运行;
    全部 .NET 10 Desktop Runtime 与 WPF 桌面库以松散 dll 形式随包落地。
  - 不打单文件(单文件每次版本更新都要自解压 175MB 到 %TEMP%,老机器启动慢到分钟级,见 8.15)
  - 输出目录:Start/(根目录平铺,8.18 由 Start/Program/ 回退:入口壳方案废弃,
    安装器直接拷平铺负载,用户安装后双击根目录 exe 即开,启动最快路径)。
    数据根定位:exe 旁的 APP/ 目录(无 APP/ 时自动创建)。
  - 对外分发通过安装器(工程根「安装程序」文件夹):安装器负载 = 本目录发布产物,
    不含模型(勾选 AI 时安装器多线程下载,见 8.18)
  - APP/mcGAME/ 为用户数据目录(versions/runtimes/mods/instances/saves/accounts/libraries/assets/installers/cache/日志/tupian;旧数据自动迁移)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- 以下为工程层硬约束的冗余确认(防止命令行覆盖丢失)
         【坑点·2026-08-28/29】本文件属性优先级高于 csproj!曾因这里写死 PublishReadyToRun=false
         导致 csproj 的 R2R 被静默覆盖(见 8.14)。今后在 csproj 调整发布属性时,
         必须同步检查本文件是否存在同名覆盖项 -->
    <SelfContained>true</SelfContained>
    <!-- 松散部署(2026-08-29):不打单文件不自解压,启动零解压开销,追求秒开(见 8.15) -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- R2R 预编译:与 csproj 保持一致(启动免 JIT 的关键,禁止改回 false);
         松散部署下不用 Composite(复合映像与松散程序集双份落地会平白多占数百 MB) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>zh-CN</SatelliteResourceLanguages>

    <!-- 输出到 Start/ 根(8.18 回退平铺:壳方案废弃,安装器负载与开发部署共用此目录) -->
    <PublishDir>$(MSBuildProjectDirectory)\..\..\Start\</PublishDir>

    <!-- 不删除现有文件:保护 APP/mcGAME/ 用户数据 -->
    <DeleteExistingFiles>false</DeleteExistingFiles>
  </PropertyGroup>
</Project>
