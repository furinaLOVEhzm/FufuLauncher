<?xml version="1.0" encoding="utf-8"?>
<!--
  可爱的芙芙 - 自包含发布配置
  版权:Copyright © 可爱的芙芙

  一键发布命令(在项目根目录执行):
    dotnet publish src\FufuLauncher\FufuLauncher.csproj /p:PublishProfile=FufuRelease

  发布前若旧 exe 被占用,先在任务管理器结束 FufuLauncher 进程。

  部署规则:
  - 自包含单文件(SelfContained=true + PublishSingleFile=true + IncludeAllContentForSelfExtract=true)
  - 全部 .NET 8 Desktop Runtime 与 WPF 桌面库打进 exe,干净机器(未装 .NET)双击直接运行
  - 禁止裁剪(PublishTrimmed=false),避免破坏 WPF/反射/动态加载
  - 输出目录:Start/ 根目录(exe 及自包含运行库)
  - 对外分发直接压缩整个 Start/ 文件夹,用户解压即用
  - APP/mcGAME/ 为用户数据目录(versions/runtimes/mods/instances/saves/accounts/libraries/assets/installers/cache/日志/tupian;旧数据自动迁移)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- 自包含:打包全部 .NET 8 Desktop Runtime 依赖,固定 win-x64,不允许可移植/any-cpu -->
    <SelfContained>true</SelfContained>

    <!-- 单文件:全部程序集打进一个 exe -->
    <PublishSingleFile>true</PublishSingleFile>

    <!-- 关键开关:WPF 等桌面库程序集必须随单文件自解压加载,
         否则在未装 .NET 8 的干净机器上会提示缺少 Microsoft.WindowsDesktop.App 8.0.0 -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <!-- ReadyToRun:预编译加速启动(略增体积) -->
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- 不裁剪:WPF 反射依赖多,裁剪会破坏 WPF/反射/动态加载逻辑 -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- 仅中文资源 -->
    <SatelliteResourceLanguages>zh-CN</SatelliteResourceLanguages>

    <!-- 输出到 Start/ 根目录(单文件 exe 直接放这里,双击即运行)
         exe 在 Start/ 时,AppPaths 走分支 B:Root=Start/APP/mcGAME,
         正好命中 Start/APP/mcGAME/tupian/ 图片资源,无需额外子目录 -->
    <PublishDir>$(MSBuildProjectDirectory)\..\..\Start\</PublishDir>

    <!-- 不删除现有文件:保护 APP/mcGAME/ 用户数据 -->
    <DeleteExistingFiles>false</DeleteExistingFiles>
  </PropertyGroup>
</Project>
