<Window x:Class="FufuLauncher.Views.AccountDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号管理 - 可爱的芙芙"
        Width="540" Height="560" MinWidth="480" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Loaded="OnLoaded">
    <Window.Resources>
        <!-- 账号卡片模板 -->
        <DataTemplate x:Key="AccountCardTemplate">
            <Border Style="{DynamicResource CardHover}" Padding="12,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 头像占位圆 -->
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                            Background="{DynamicResource PrimaryGradientBrush}" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppForeground}"/>
                            <Border CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Background="{Binding TypeBadgeBg}">
                                <TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="White"/>
                            </Border>
                            <TextBlock Text="● 使用中" FontSize="10" Foreground="{DynamicResource SuccessBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       Visibility="{Binding IsCurrentVis}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding UuidShort}" FontSize="11" Opacity="0.5"
                                   Foreground="{DynamicResource AppForeground}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="使用" Tag="{Binding Uuid}" Click="UseAccount_Click"
                                Style="{DynamicResource PrimaryButton}" Padding="12,6" Margin="0,0,6,0"/>
                        <Button Content="删除" Tag="{Binding Uuid}" Click="DeleteAccount_Click"
                                Style="{DynamicResource DangerButton}" Padding="12,6"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="10">
        <Border Style="{DynamicResource DialogRoot}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 渐变标题栏(可拖动) -->
                <Border Grid.Row="0" Style="{DynamicResource DialogTitleBar}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="账号管理" FontSize="15" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Foreground="White" Click="Close_Click" Style="{DynamicResource GhostButton}"/>
                    </Grid>
                </Border>

                <!-- 账号列表 -->
                <Grid Grid.Row="1" Margin="18,14,18,4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AccountList" ItemTemplate="{StaticResource AccountCardTemplate}"/>
                    </ScrollViewer>
                    <!-- 空态提示 -->
                    <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🌙" FontSize="34" HorizontalAlignment="Center" Opacity="0.6"/>
                        <TextBlock Text="还没有账号,点击下方按钮添加" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 底部操作区 -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardBorder}"
                        Padding="18,12">
                    <Grid>
                        <TextBlock Text="账号数据存放于 accounts 目录,与游戏数据严格隔离"
                                   FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnMsLogin" Content="🔐 添加微软账号" Style="{DynamicResource PrimaryButton}"
                                    Margin="0,0,8,0" Click="MsLogin_Click"/>
                            <Button Content="🎭 添加离线账号" Style="{DynamicResource SecondaryButton}"
                                    Click="OfflineLogin_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
