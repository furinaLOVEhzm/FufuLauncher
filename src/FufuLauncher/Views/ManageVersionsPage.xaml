<!-- ManageVersionsPage.xaml — 管理游戏版本(全新页面)
     可爱的芙芙
     支持卸载指定游戏版本。卸载范围:版本本体 + 该版本的模组 + 版本配置文件。
     ⚠ 硬性约束:严禁删除 saves 存档文件夹;绝不触碰 runtimes 下的 Java 运行时;
     运行中的版本禁止卸载;删除后台异步执行不阻塞 UI;卸载前弹出二次确认弹窗。 -->
<Page x:Class="FufuLauncher.Views.ManageVersionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="680" d:DesignWidth="1000"
      Loaded="Page_OnLoaded">
    <Grid Margin="26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="2,0,0,12">
            <TextBlock Text="管理游戏版本" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource AppForeground}"/>
            <TextBlock Text="卸载指定游戏版本(版本本体 + 模组 + 版本配置)。存档与 Java 运行时受保护,不会被删除。"
                       FontSize="12" Opacity="0.6" Foreground="{DynamicResource AppForeground}"
                       Margin="1,4,0,0"/>
        </StackPanel>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="14,10" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="🔄 刷新列表" Style="{DynamicResource SecondaryButton}"
                        Click="Refresh_Click"/>
                <TextBlock x:Name="TxtSummary" DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.7" Foreground="{DynamicResource AppForeground}"
                           Text="正在加载…" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- 实例列表 -->
        <ListBox x:Name="InstanceList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,6,8"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource Card}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 信息 -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppForeground}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                    <Border Style="{DynamicResource TypeChip}" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding VersionText}" FontSize="10"
                                                   Foreground="{DynamicResource AppForeground}"/>
                                    </Border>
                                    <Border Style="{DynamicResource MetaChip}" Margin="6,0,0,0"
                                            Visibility="{Binding RunningVis}">
                                        <TextBlock Text="▶ 运行中" FontSize="10" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding MetaText}" FontSize="11" Opacity="0.55"
                                           Foreground="{DynamicResource AppForeground}" Margin="1,5,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- 受保护提示 -->
                            <TextBlock Grid.Column="1" Text="🛡 存档受保护" FontSize="10.5" Opacity="0.5"
                                       VerticalAlignment="Center" Margin="0,0,14,0"
                                       Foreground="{DynamicResource AppForeground}"/>

                            <!-- 卸载按钮 -->
                            <Button Grid.Column="2" Content="🗑 卸载" Style="{DynamicResource DangerButton}"
                                    Tag="{Binding}" Click="Uninstall_Click" VerticalAlignment="Center"
                                    IsEnabled="{Binding CanUninstall}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Margin="2,10,6,4">
            <TextBlock x:Name="TxtStatus" FontSize="12" Opacity="0.7"
                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Text="就绪"/>
        </Border>
    </Grid>
</Page>
