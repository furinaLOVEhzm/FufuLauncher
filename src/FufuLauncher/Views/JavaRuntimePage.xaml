<!-- JavaRuntimePage.xaml — Java 管理(全新重写)
     可爱的芙芙
     读取 APP\mcGAME\runtimes 目录;支持新增本地 Java、删除、设为默认、刷新列表。 -->
<Page x:Class="FufuLauncher.Views.JavaRuntimePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="680" d:DesignWidth="1000"
      Loaded="Page_OnLoaded">
    <Grid Margin="26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="2,0,0,12">
            <TextBlock Text="Java 管理" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource AppForeground}"/>
            <TextBlock x:Name="TxtRuntimesDir" Text="" FontSize="12" Opacity="0.6" Margin="1,4,0,0"
                       Foreground="{DynamicResource AppForeground}"/>
        </StackPanel>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="➕ 新增本地 Java" Style="{DynamicResource PrimaryButton}"
                        Click="AddLocalJava_Click"/>
                <Button DockPanel.Dock="Left" Content="⬇ 下载新 Java" Style="{DynamicResource SecondaryButton}"
                        Margin="10,0,0,0" Click="GoDownload_Click"/>
                <Button DockPanel.Dock="Right" Content="🔄 刷新列表" Style="{DynamicResource SecondaryButton}"
                        Click="Refresh_Click"/>
                <TextBlock x:Name="TxtSummary" VerticalAlignment="Center" Margin="16,0,12,0" FontSize="12"
                           Opacity="0.65" Foreground="{DynamicResource AppForeground}"/>
            </DockPanel>
        </Border>

        <!-- 列表 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="JavaList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource Card}" Padding="16,13" Margin="0,0,6,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 图标 -->
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                            Background="{DynamicResource SubtleFillBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="☕" FontSize="20" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 信息 -->
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppForeground}"/>
                                            <Border Style="{DynamicResource MetaChip}" Margin="10,0,0,0"
                                                    Visibility="{Binding DefaultVis}">
                                                <TextBlock Text="★ 默认" FontSize="10" Foreground="White"/>
                                            </Border>
                                            <Border Style="{DynamicResource TypeChip}" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                           Foreground="{DynamicResource AppForeground}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding MetaText}" FontSize="11" Opacity="0.55"
                                                   Foreground="{DynamicResource AppForeground}" Margin="1,5,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- 操作按钮 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="★ 设为默认" Style="{DynamicResource PrimaryButton}"
                                                Tag="{Binding}" Click="SetDefault_Click"
                                                IsEnabled="{Binding CanSetDefault}"/>
                                        <Button Content="🗑 删除" Style="{DynamicResource DangerButton}"
                                                Margin="8,0,0,0" Tag="{Binding}" Click="Delete_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="TxtEmpty" Text="runtimes 目录暂无 Java,点击「下载新 Java」或「新增本地 Java」添加。"
                           FontSize="12" Opacity="0.55" HorizontalAlignment="Center" Margin="0,36,0,0"
                           Foreground="{DynamicResource AppForeground}" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
