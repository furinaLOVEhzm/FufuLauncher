<!-- DownloadPage.xaml — 下载中心(全新重写)
     可爱的芙芙
     只含两类内容:游戏版本下载、Java 运行时下载。
     接入国内镜像源(BMCLAPI/华为云),完整进度条 + 超时重试 + 错误提示。 -->
<Page x:Class="FufuLauncher.Views.DownloadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="680" d:DesignWidth="1000"
      Loaded="Page_OnLoaded">
    <Grid Margin="26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 标题 ============ -->
        <StackPanel x:Name="PageHeader" Grid.Row="0" Margin="2,0,0,12">
            <TextBlock Text="下载中心" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource AppForeground}"/>
            <TextBlock x:Name="TxtSourceLabel" Text="游戏版本与 Java 运行时下载 · 国内镜像加速" FontSize="12"
                       Opacity="0.6" Foreground="{DynamicResource AppForeground}" Margin="1,4,0,0"/>
        </StackPanel>

        <!-- ============ 内容区:双 Tab 与页内加载器选择视图(覆盖切换) ============ -->
        <Grid Grid.Row="1">
        
        <!-- ============ 双 Tab:游戏版本 / Java ============ -->
        <TabControl x:Name="TabMain" Style="{DynamicResource FufuTab}" Background="Transparent" BorderThickness="0"
                    SelectionChanged="Tab_SelectionChanged">

            <!-- ================= 游戏版本下载 ================= -->
            <TabItem Header="🎮 游戏版本下载" Style="{DynamicResource FufuTabItem}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 工具栏:搜索 + 分类筛选 + 刷新 -->
                    <Border Grid.Row="0" Style="{DynamicResource Card}" Padding="14,10" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBox x:Name="TxtSearch" DockPanel.Dock="Left" Width="240"
                                     Style="{DynamicResource SearchBox}" Tag="搜索版本号…"
                                     TextChanged="TxtSearch_TextChanged"/>
                            <Button DockPanel.Dock="Right" Content="🔄 刷新清单"
                                    Style="{DynamicResource SecondaryButton}" Click="RefreshManifest_Click"/>
                            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                <RadioButton Content="全部" GroupName="VerFilter" IsChecked="True"
                                             Style="{DynamicResource FilterRadio}" Checked="FilterRadio_Checked"/>
                                <RadioButton Content="正式版" GroupName="VerFilter"
                                             Style="{DynamicResource FilterRadio}" Checked="FilterRadio_Checked"/>
                                <RadioButton Content="快照" GroupName="VerFilter"
                                             Style="{DynamicResource FilterRadio}" Checked="FilterRadio_Checked"/>
                                <RadioButton Content="Beta" GroupName="VerFilter"
                                             Style="{DynamicResource FilterRadio}" Checked="FilterRadio_Checked"/>
                                <RadioButton Content="远古版" GroupName="VerFilter"
                                             Style="{DynamicResource FilterRadio}" Checked="FilterRadio_Checked"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 版本列表 -->
                    <ListBox x:Name="VersionList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,6,8"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource Card}" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 左侧色块标签(Badge):正式蓝/Beta黄/快照紫/远古灰,白字 -->
                                        <Border Grid.Column="0" Background="{Binding BadgeBrush}" CornerRadius="4"
                                                Padding="8,3" MinWidth="46" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Version.TypeDisplay}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="White" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 版本号(颜色保持原样)+ 发布日期 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Version.Id}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppForeground}"/>
                                                <Border Style="{DynamicResource MetaChip}" Margin="10,0,0,0"
                                                        Visibility="{Binding InstalledVis}">
                                                    <TextBlock Text="✓ 已安装" FontSize="10" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Version.ReleaseTimeDisplay, StringFormat=发布于 {0}}"
                                                       FontSize="11" Opacity="0.55"
                                                       Foreground="{DynamicResource AppForeground}" Margin="1,5,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="⬇ 安装此版本" Tag="{Binding}"
                                                Style="{DynamicResource PrimaryButton}"
                                                VerticalAlignment="Center" Click="InstallVersion_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- ================= Java 运行时下载 ================= -->
            <TabItem x:Name="TabJava" Header="☕ Java 运行时下载" Style="{DynamicResource FufuTabItem}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{DynamicResource Card}" Padding="14,10" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock x:Name="TxtJavaMirror" DockPanel.Dock="Left" VerticalAlignment="Center"
                                       FontSize="12" Opacity="0.7" Foreground="{DynamicResource AppForeground}"
                                       Text="镜像源:加载中…"/>
                            <Button DockPanel.Dock="Right" Content="🔄 刷新列表"
                                    Style="{DynamicResource SecondaryButton}" Click="RefreshJdk_Click"/>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                       FontSize="11" Opacity="0.5" Foreground="{DynamicResource AppForeground}"
                                       Text="已下载的 Java 会合并显示,不会重复"/>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="JdkList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource Card}" Padding="16,12" Margin="0,0,6,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppForeground}"/>
                                                        <Border Style="{DynamicResource MetaChip}" Margin="10,0,0,0"
                                                                Visibility="{Binding LtsVis}">
                                                            <TextBlock Text="LTS 长期支持" FontSize="10" Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="1,5,0,0"
                                                               Opacity="0.6" Foreground="{DynamicResource AppForeground}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{Binding ButtonText}" Tag="{Binding}"
                                                        Style="{DynamicResource PrimaryButton}" IsEnabled="{Binding CanDownload}"
                                                        VerticalAlignment="Center" Click="DownloadJdk_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="TxtJavaStatus" FontSize="12" Opacity="0.7" Margin="4,6,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="JavaProgress" Height="6" Margin="4,10,10,0" Visibility="Collapsed"
                                         Style="{DynamicResource FufuProgress}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
        
        <!-- ============ 页内加载器选择视图(替代旧弹窗,点「安装此版本」进入) ============ -->
        <Border x:Name="LoaderSelectPanel" Visibility="Collapsed"
                Background="{DynamicResource AppBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部:返回 + 标题 + 当前要安装的游戏版本号 -->
                <DockPanel Grid.Row="0" Margin="2,0,0,14">
                    <Button DockPanel.Dock="Left" Content="←" Style="{DynamicResource GhostButton}"
                            VerticalAlignment="Center" Click="LoaderCancel_Click"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="选择模组加载器" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center"/>
                        <Border Style="{DynamicResource MetaChip}" Margin="12,0,0,0">
                            <TextBlock x:Name="TxtLoaderVersion" Text="Minecraft" FontSize="12" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- 中部:加载器列表(点整行选中,选中条目背景高亮;选中后右侧出现版本下拉) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LoaderList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="16,12" Margin="0,0,6,8" Cursor="Hand"
                                        MouseLeftButtonUp="LoaderRow_MouseUp" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- 左:单选指示圈(选中显示 ✓) -->
                                        <Border Width="20" Height="20" CornerRadius="10" BorderThickness="1.5"
                                                VerticalAlignment="Center" Margin="0,0,14,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="✓" FontSize="12" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding CheckVis}"/>
                                        </Border>
                                        <!-- 中:加载器名称 + 一行小字简介 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppForeground}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.6"
                                                       Foreground="{DynamicResource AppForeground}" Margin="1,4,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <!-- 右:版本下拉组件(加载中/成功可用/失败置灰+重试/暂无适配置灰) -->
                                        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Width="200" Visibility="{Binding ComboVis}">
                                                    <ComboBox Style="{DynamicResource FufuCombo}" Width="200"
                                                              DisplayMemberPath="Display"
                                                              IsEnabled="{Binding ComboEnabled}"
                                                              ToolTip="{Binding ErrorText}"
                                                              ItemsSource="{Binding ComboItems}"
                                                              SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                                              SelectionChanged="LoaderVersion_SelectionChanged">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <TextBlock Text="{Binding HeaderText}"
                                                                               Visibility="{Binding HeaderVis}" FontSize="11"
                                                                               FontWeight="SemiBold" Opacity="0.55"
                                                                               Foreground="{DynamicResource AppForeground}"/>
                                                                    <TextBlock Text="{Binding Display}"
                                                                               Visibility="{Binding ItemVis}" FontSize="12"
                                                                               Foreground="{DynamicResource AppForeground}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <!-- 覆盖提示:获取失败/暂无适配时盖在置灰下拉框上(不拦截点击) -->
                                                    <Border IsHitTestVisible="False" Visibility="{Binding PlaceholderVis}"
                                                            Background="{DynamicResource CardBackground}"
                                                            CornerRadius="8" Margin="2,2,26,2">
                                                        <TextBlock Text="{Binding PlaceholderText}" FontSize="12" Opacity="0.6"
                                                                   Foreground="{DynamicResource AppForeground}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="正在获取版本列表…" FontSize="12" Opacity="0.6"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AppForeground}"
                                                           Visibility="{Binding LoadingVis}"/>
                                                <Button Content="🔄 重试" Tag="{Binding}" Click="LoaderRetry_Click"
                                                        Style="{DynamicResource SecondaryButton}"
                                                        Padding="12,3" FontSize="11" Margin="8,0,0,0"
                                                        VerticalAlignment="Center" ToolTip="{Binding ErrorText}"
                                                        Visibility="{Binding ErrorVis}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 底部:提示 + 取消 / 确定(选了加载器必须先选定具体版本才可确定) -->
                <DockPanel Grid.Row="2" Margin="0,16,2,4">
                    <TextBlock x:Name="TxtLoaderHint" DockPanel.Dock="Left" FontSize="12"
                               VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}"
                               Opacity="0.9"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Style="{DynamicResource SecondaryButton}" Width="96"
                                Click="LoaderCancel_Click"/>
                        <Button x:Name="BtnLoaderConfirm" Content="确定" Style="{DynamicResource PrimaryButton}" Width="96"
                                Margin="10,0,0,0" Click="LoaderConfirm_Click"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
        
        </Grid>
        
        <!-- ============ 底部:统一下载进度卡片 ============ -->
        <Border x:Name="ProgressCard" Grid.Row="2" Style="{DynamicResource Card}" Padding="16,12"
                Margin="0,12,0,4" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <TextBlock x:Name="TxtStage" DockPanel.Dock="Left" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppForeground}" Text="准备中…"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnRetry" Content="🔁 重试" Style="{DynamicResource SecondaryButton}"
                                Padding="12,4" FontSize="11" Visibility="Collapsed" Click="Retry_Click"/>
                        <Button Content="✕ 取消" Style="{DynamicResource DangerButton}" Margin="8,0,0,0"
                                Padding="12,4" FontSize="11" Click="CancelDownload_Click"/>
                    </StackPanel>
                </DockPanel>
                <ProgressBar x:Name="OverallBar" Grid.Row="1" Height="8" Margin="0,10,0,0"
                             Style="{DynamicResource FufuProgress}"/>
                <DockPanel Grid.Row="2" Margin="0,6,0,0">
                    <TextBlock x:Name="TxtSubStage" DockPanel.Dock="Left" FontSize="11" Opacity="0.6"
                               Foreground="{DynamicResource AppForeground}"/>
                    <TextBlock x:Name="TxtSpeed" DockPanel.Dock="Right" FontSize="11" Opacity="0.6"
                               HorizontalAlignment="Right" Foreground="{DynamicResource AppForeground}"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
