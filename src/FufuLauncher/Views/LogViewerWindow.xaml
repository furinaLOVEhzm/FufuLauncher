<Window x:Class="FufuLauncher.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日志控制台 - 可爱的芙芙"
        Width="940" Height="640" MinWidth="680" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded" Closed="OnClosed">
    <Border Margin="10">
        <Border Style="{DynamicResource DialogRoot}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 渐变标题栏(可拖动) -->
                <Border Grid.Row="0" Style="{DynamicResource DialogTitleBar}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📜" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="日志控制台" FontSize="15" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtLogPath" FontSize="10" Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center" Margin="14,2,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Foreground="White" Click="Close_Click"
                                Style="{DynamicResource GhostButton}"/>
                    </Grid>
                </Border>

                <!-- 内容:应用日志 / 游戏日志 双栏完整输出(自动换行不截断) -->
                <Grid Grid.Row="1" Margin="16,12,16,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource PrimaryBrush}"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="启动器应用日志" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppForeground}"/>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{DynamicResource LogPanel}">
                            <TextBox x:Name="AppLogBox" Style="{DynamicResource LogBox}"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="游戏输出日志" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppForeground}"/>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{DynamicResource LogPanel}">
                            <TextBox x:Name="GameLogBox" Style="{DynamicResource LogBox}"/>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 底部工具栏 -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource CardBorder}" Padding="16,10">
                    <Grid>
                        <TextBlock Text="日志统一写入 APP\mcGAME\日志,完整显示不截断,遵循自动清理策略"
                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="打开日志目录" Style="{DynamicResource SecondaryButton}"
                                    Margin="0,0,8,0" Click="OpenLogDir_Click"/>
                            <Button Content="复制应用日志" Style="{DynamicResource SecondaryButton}"
                                    Margin="0,0,8,0" Click="CopyApp_Click"/>
                            <Button Content="复制游戏日志" Style="{DynamicResource SecondaryButton}"
                                    Margin="0,0,8,0" Click="CopyGame_Click"/>
                            <Button Content="关闭" Width="84" Style="{DynamicResource PrimaryButton}"
                                    Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
