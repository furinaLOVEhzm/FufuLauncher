<Page x:Class="FufuLauncher.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="关于" Background="Transparent"
      Loaded="AboutPage_OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22" MaxWidth="720" HorizontalAlignment="Stretch">

            <!-- 产品标识卡片 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,16" Padding="28,26">
                <StackPanel HorizontalAlignment="Center">
                    <!-- 关于页 Logo:优先加载专属 Logo(tupian\tub.png),失败时回退内置色块 -->
                    <Border x:Name="AboutLogoBox" Width="64" Height="64" CornerRadius="16"
                            Background="{DynamicResource LogoBrush}" ClipToBounds="True"
                            HorizontalAlignment="Center">
                        <Image x:Name="AboutLogoImage" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="可爱的芙芙" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource AppForeground}" Margin="0,14,0,2"/>
                    <TextBlock Text="FufuLauncher" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="TxtVersion" Text="" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 简介卡片 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,16" Padding="24,20">
                <StackPanel>
                    <TextBlock Text="关于本启动器" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppForeground}" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="22" FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="可爱的芙芙 FufuLauncher 是一款 Minecraft Java 版第三方启动器,提供游戏版本管理、隔离 Java 运行时下载、模组管理、账号登录(离线 / 微软 OAuth)、下载源管理、环境自检与程序自身更新等能力。全部用户数据固化在程序目录 APP\MCGAME 下,不向系统盘写入任何业务数据。"/>
                    <!-- 作者联系方式 -->
                    <TextBlock Margin="0,12,0,0" FontSize="13" Cursor="Hand"
                               Foreground="{DynamicResource PrimaryBrush}"
                               ToolTip="点击复制 QQ 号" MouseLeftButtonUp="TxtQQ_Copy"
                               Text="🐧 作者 QQ:2703706747(点击复制)"/>
                </StackPanel>
            </Border>

            <!-- 核心特性卡片 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,16" Padding="24,20">
                <StackPanel>
                    <TextBlock Text="核心特性" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppForeground}" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="24" FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="🎮 游戏版本与整合包导入&#x0a;☕ Java 运行时隔离下载,一个版本一套 Java&#x0a;⬇ 下载队列:总进度 / 单项进度、暂停继续、哈希校验&#x0a;📜 应用日志与游戏日志完全分离&#x0a;🩺 环境自检,问题分级提示&#x0a;🔄 程序自身增量更新与回退保护"/>
                </StackPanel>
            </Border>

            <!-- 版权 -->
            <TextBlock x:Name="TxtCopyright" Text="" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.7" Margin="0,4,0,20"/>
        </StackPanel>
    </ScrollViewer>
</Page>
