<!-- SettingsPage.xaml — 设置(全新重写)
     可爱的芙芙
     背景设置 / 内存分配 / JVM 多核优化 / 镜像源切换 / 应用日志自动清理。
     全部控件即时生效并写入 APP\mcGAME\Config\config.json。 -->
<Page x:Class="FufuLauncher.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,18" MaxWidth="900">

            <!-- 标题 -->
            <TextBlock Text="设置" FontSize="24" FontWeight="Bold" Margin="2,0,0,4"
                       Foreground="{DynamicResource AppForeground}"/>
            <TextBlock Text="全部更改即时保存,启动游戏时直接生效" FontSize="12" Opacity="0.6" Margin="3,0,0,14"
                       Foreground="{DynamicResource AppForeground}"/>

            <!-- 1. 外观主题 -->
            <Border Style="{DynamicResource Card}" Padding="18,14" Margin="0,0,6,12">
                <StackPanel>
                    <TextBlock Text="🎨 外观主题" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"
                               Foreground="{DynamicResource AppForeground}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbThemeLight" Content="☀ 浅色" GroupName="Theme"
                                     Style="{DynamicResource FilterRadio}" Checked="RbThemeLight_Checked"/>
                        <RadioButton x:Name="RbThemeDark" Content="🌙 深色" GroupName="Theme" Margin="14,0,0,0"
                                     Style="{DynamicResource FilterRadio}" Checked="RbThemeDark_Checked"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. 背景设置(单层背景:图片或视频,芙宁娜标志性壁纸内置兜底) -->
            <Border Style="{DynamicResource Card}" Padding="18,14" Margin="0,0,6,12">
                <StackPanel>
                    <TextBlock Text="🖼 背景设置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource AppForeground}"/>
                    <TextBlock Text="单层背景,支持图片或视频;「无背景」模式下仍保留芙宁娜标志性壁纸底色。"
                               FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,10"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="BgNone" Content="无背景" GroupName="BgType"
                                     Style="{DynamicResource FilterRadio}" Checked="BgNone_Checked"/>
                        <RadioButton x:Name="BgImage" Content="🖼 图片" GroupName="BgType" Margin="14,0,0,0"
                                     Style="{DynamicResource FilterRadio}" Checked="BgImage_Checked"/>
                        <RadioButton x:Name="BgVideo" Content="🎬 视频" GroupName="BgType" Margin="14,0,0,0"
                                     Style="{DynamicResource FilterRadio}" Checked="BgVideo_Checked"/>
                        <Button Content="📁 选择文件…" Style="{DynamicResource SecondaryButton}"
                                Margin="20,0,0,0" Click="BtnBrowseBg_Click"/>
                    </StackPanel>

                    <!-- 背景透明度 -->
                    <TextBlock Text="背景不透明度" FontSize="11" Opacity="0.6" Margin="0,2,0,2"
                               Foreground="{DynamicResource AppForeground}"/>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock x:Name="TxtOpacity" DockPanel.Dock="Right" Width="44" TextAlignment="Right"
                                   FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Slider x:Name="SldOpacity" Minimum="0.1" Maximum="1" Value="0.6"
                                VerticalAlignment="Center" ValueChanged="SldOpacity_ValueChanged"/>
                    </DockPanel>

                    <!-- 视频选项(仅视频背景时可见) -->
                    <StackPanel x:Name="VideoOptionsPanel" Visibility="Collapsed" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="ChkVideoMuted" Content="视频静音" VerticalAlignment="Center"
                                      Checked="ChkVideoMuted_Changed" Unchecked="ChkVideoMuted_Changed"/>
                            <TextBlock Text="播放速度" VerticalAlignment="Center" Margin="24,0,8,0" FontSize="11"
                                       Foreground="{DynamicResource AppForeground}"/>
                            <Slider x:Name="SldVideoSpeed" Minimum="0.25" Maximum="3" Value="1" Width="180"
                                    VerticalAlignment="Center" ValueChanged="SldVideoSpeed_ValueChanged"/>
                            <TextBlock x:Name="TxtVideoSpeed" VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtBgFile" FontSize="11" Opacity="0.6" Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. 内存分配 -->
            <Border Style="{DynamicResource Card}" Padding="18,14" Margin="0,0,6,12">
                <StackPanel>
                    <TextBlock Text="💾 内存分配" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"
                               Foreground="{DynamicResource AppForeground}"/>

                    <!-- 整机内存快照 -->
                    <ProgressBar x:Name="PbMemory" Height="8" Minimum="0" Maximum="100" Margin="0,0,0,6"
                                 Style="{DynamicResource FufuProgress}"/>
                    <TextBlock x:Name="TxtMemInfo" FontSize="11" Opacity="0.65" Margin="0,0,0,12"
                               Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                               Text="正在读取内存信息…"/>

                    <CheckBox x:Name="ChkAutoMemory" Content="智能自动内存分配(读取整机物理内存,强制为系统保留至少 3GB,启动时生效)"
                              Checked="ChkAutoMemory_Changed" Unchecked="ChkAutoMemory_Changed" Margin="0,0,0,10"/>

                    <!-- 使用档位:纯净 / 中型模组 / 大型光影(借鉴 PCL2/HMCL 三档推荐) -->
                    <StackPanel x:Name="TierPanel" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="使用场景" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                   Foreground="{DynamicResource AppForeground}"/>
                        <RadioButton x:Name="RbTierVanilla" Content="🌿 纯净版" GroupName="MemTier"
                                     Style="{DynamicResource FilterRadio}" Checked="Tier_Checked"/>
                        <RadioButton x:Name="RbTierModded" Content="🧩 中型模组" GroupName="MemTier" Margin="14,0,0,0"
                                     Style="{DynamicResource FilterRadio}" Checked="Tier_Checked"/>
                        <RadioButton x:Name="RbTierShader" Content="✨ 大型光影" GroupName="MemTier" Margin="14,0,0,0"
                                     Style="{DynamicResource FilterRadio}" Checked="Tier_Checked"/>
                        <TextBlock Text="内存上限" VerticalAlignment="Center" Margin="28,0,8,0" FontSize="12"
                                   Foreground="{DynamicResource AppForeground}"/>
                        <ComboBox x:Name="CbMaxLimit" Width="90" Style="{DynamicResource FufuCombo}"
                                  SelectionChanged="CbMaxLimit_SelectionChanged">
                            <ComboBoxItem Content="4 GB"/>
                            <ComboBoxItem Content="8 GB"/>
                            <ComboBoxItem Content="16 GB"/>
                            <ComboBoxItem Content="32 GB"/>
                        </ComboBox>
                    </StackPanel>

                    <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="8" Padding="12,8"
                            Margin="0,0,0,10">
                        <TextBlock x:Name="TxtSmartHint" FontSize="11.5"
                                   Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>
                    </Border>

                    <CheckBox x:Name="ChkPreCommit" Content="内存预提交(AlwaysPreTouch:启动时一次性提交全部堆页,固定堆 Xms=Xmx,避免游戏中途缺页抖动)"
                              Margin="0,0,0,10" Checked="ChkPreCommit_Changed" Unchecked="ChkPreCommit_Changed"/>

                    <!-- 堆外直接内存硬锁(MaxDirectMemorySize):防止 Iris/Sodium DirectBuffer 无限膨胀 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="堆外直接内存上限(MB)" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"
                                   Foreground="{DynamicResource AppForeground}"
                                   ToolTip="硬锁 -XX:MaxDirectMemorySize,防止堆外 DirectBuffer 无限膨胀。0 = 自动取 Xmx 的 0.75 倍"/>
                        <TextBox x:Name="TxtDirectMem" Width="80" VerticalContentAlignment="Center"
                                 LostFocus="TxtDirectMem_LostFocus"
                                 ToolTip="0 = 自动(Xmx × 0.75);手动输入 MB 数覆盖,回车/失焦保存"/>
                        <TextBlock x:Name="TxtDirectHint" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <!-- 手动 Xms/Xmx(关闭智能分配时使用) -->
                    <StackPanel x:Name="ManualMemPanel" Orientation="Horizontal">
                        <TextBlock Text="初始 Xms" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"
                                   Foreground="{DynamicResource AppForeground}"/>
                        <ComboBox x:Name="CbXms" Width="96" IsEditable="True" Style="{DynamicResource FufuCombo}">
                            <ComboBoxItem Content="0.5"/>
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="8"/>
                        </ComboBox>
                        <TextBlock Text="GB    最大 Xmx" VerticalAlignment="Center" Margin="18,0,8,0" FontSize="12"
                                   Foreground="{DynamicResource AppForeground}"/>
                        <ComboBox x:Name="CbXmx" Width="96" IsEditable="True" Style="{DynamicResource FufuCombo}">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="16"/>
                        </ComboBox>
                        <TextBlock Text="GB" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource AppForeground}"/>
                        <Button Content="保存内存设置" Style="{DynamicResource PrimaryButton}"
                                Margin="24,0,0,0" Click="BtnSaveMemory_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. JVM 多核优化 -->
            <Border Style="{DynamicResource Card}" Padding="18,14" Margin="0,0,6,12">
                <StackPanel>
                    <TextBlock Text="⚙️ JVM 多核优化" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource AppForeground}"/>
                    <TextBlock x:Name="TxtCoreInfo" FontSize="11" Opacity="0.6" Margin="0,0,0,10"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <CheckBox x:Name="ChkGcOpt" Content="GC 多核优化(ParallelGCThreads / ConcGCThreads / CICompilerCount)"
                              Margin="0,0,0,8" Checked="JvmOpt_Changed" Unchecked="JvmOpt_Changed"/>
                    <CheckBox x:Name="ChkHighPriority" Content="Java 进程高优先级(AboveNormal,禁止 Realtime)"
                              Margin="0,0,0,8" Checked="JvmOpt_Changed" Unchecked="JvmOpt_Changed"/>
                    <CheckBox x:Name="ChkCpuAffinity" Content="CPU 亲和性增强(绑定核心,减少线程切换)"
                              Margin="0,0,0,10" Checked="JvmOpt_Changed" Unchecked="JvmOpt_Changed"/>

                    <TextBlock Text="GC 参数预览" FontSize="11" Opacity="0.6" Margin="0,0,0,4"
                               Foreground="{DynamicResource AppForeground}"/>
                    <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,0,12">
                        <TextBlock x:Name="TxtGcPreview" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppForeground}"/>
                    </Border>

                    <TextBlock Text="高级模式:自定义 JVM 参数(按版本独立保存,保存前语法校验)" FontSize="12" FontWeight="SemiBold"
                               Margin="0,6,0,6" Foreground="{DynamicResource AppForeground}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="目标版本" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"
                                   Foreground="{DynamicResource AppForeground}"/>
                        <ComboBox x:Name="CbTargetInst" Width="260" Style="{DynamicResource FufuCombo}"
                                  SelectionChanged="CbTargetInst_SelectionChanged"/>
                    </StackPanel>
                    <TextBox x:Name="TxtInstArgs" Height="54" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="🔍 语法校验" Style="{DynamicResource SecondaryButton}" Click="BtnValidateArgs_Click"/>
                        <Button Content="💾 校验并保存到该版本" Style="{DynamicResource PrimaryButton}" Margin="10,0,0,0"
                                Click="BtnSaveArgs_Click"/>
                        <TextBlock x:Name="TxtArgsStatus" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="内存(-Xms/-Xmx)、classpath 由启动器统一管理,不允许手动指定;其余合法 JVM 参数均可(如 -XX:+UseG1GC、-Dfml….*)。"
                               FontSize="10.5" Opacity="0.55" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>

            <!-- 5. 镜像源切换 -->
            <Border Style="{DynamicResource Card}" Padding="18,14" Margin="0,0,6,12">
                <StackPanel>
                    <TextBlock Text="🌐 下载镜像源" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"
                               Foreground="{DynamicResource AppForeground}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="游戏资源源" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                   Foreground="{DynamicResource AppForeground}"/>
                        <RadioButton x:Name="SrcBmcl" Content="BMCLAPI 国内镜像(推荐)" GroupName="GameSrc"
                                     Style="{DynamicResource FilterRadio}" Checked="SrcBmcl_Checked"/>
                        <RadioButton x:Name="SrcMojang" Content="Mojang 官方源" GroupName="GameSrc" Margin="16,0,0,0"
                                     Style="{DynamicResource FilterRadio}" Checked="SrcMojang_Checked"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Java 下载源" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                   Foreground="{DynamicResource AppForeground}"/>
                        <ComboBox x:Name="CbJavaMirror" Width="230" Style="{DynamicResource FufuCombo}"
                                  SelectionChanged="CbJavaMirror_SelectionChanged"/>
                    </StackPanel>
                    <TextBlock Text="切换后立即生效:版本清单缓存自动清空,下次进入下载中心从新源拉取。"
                               FontSize="11" Opacity="0.6" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>

            <!-- 6. 应用日志自动清理 -->
            <Border Style="{DynamicResource Card}" Padding="18,14" Margin="0,0,6,12">
                <StackPanel>
                    <TextBlock Text="🧹 应用日志自动清理" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource AppForeground}"/>
                    <TextBlock x:Name="TxtLogDir" FontSize="11" Opacity="0.6" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <CheckBox x:Name="ChkLogClean" Content="启动时自动清理旧应用日志(防止日志文件无限膨胀占用磁盘)"
                              Margin="0,0,0,10" Checked="ChkLogClean_Changed" Unchecked="ChkLogClean_Changed"/>

                    <StackPanel x:Name="LogCleanOptions" Orientation="Horizontal">
                        <TextBlock Text="保留最新" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"
                                   Foreground="{DynamicResource AppForeground}"/>
                        <ComboBox x:Name="CbKeepCount" Width="80" Style="{DynamicResource FufuCombo}"
                                  SelectionChanged="LogParam_Changed">
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="20"/>
                            <ComboBoxItem Content="30"/>
                        </ComboBox>
                        <TextBlock Text="份    每" VerticalAlignment="Center" Margin="18,0,8,0" FontSize="12"
                                   Foreground="{DynamicResource AppForeground}"/>
                        <ComboBox x:Name="CbCleanEvery" Width="70" Style="{DynamicResource FufuCombo}"
                                  SelectionChanged="LogParam_Changed">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="10"/>
                        </ComboBox>
                        <TextBlock Text="次启动清理一次" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource AppForeground}"/>
                        <Button Content="🧹 立即清理" Style="{DynamicResource SecondaryButton}"
                                Margin="24,0,0,0" Click="BtnCleanNow_Click"/>
                    </StackPanel>
                    <TextBlock Text="日志统一写入 APP\mcGAME\日志(游戏输出与应用日志分离);已取消按天定时,改为按启动次数触发,后台执行不阻塞界面。"
                               FontSize="11" Opacity="0.6" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>

            <Border Height="10"/>
        </StackPanel>
    </ScrollViewer>
</Page>
