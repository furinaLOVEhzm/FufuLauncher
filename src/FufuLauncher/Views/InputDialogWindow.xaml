<Window x:Class="FufuLauncher.Views.InputDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" Width="440" SizeToContent="Height" MinWidth="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Loaded="OnLoaded">
    <Border Margin="10">
        <Border Style="{DynamicResource DialogRoot}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 渐变标题栏(可拖动) -->
                <Border Grid.Row="0" Style="{DynamicResource DialogTitleBar}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="16,0">
                        <TextBlock x:Name="TxtTitle" Text="请输入" FontSize="14" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Foreground="White" Click="BtnCancel_Click"
                                Style="{DynamicResource GhostButton}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="20,16,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtPrompt" Grid.Row="0" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppForeground}" Opacity="0.85" Margin="0,0,0,12"/>

                    <TextBox x:Name="TxtInput" Grid.Row="1" Style="{DynamicResource FufuTextBox}" Height="36"
                             VerticalContentAlignment="Center" KeyDown="TxtInput_KeyDown"/>
                    <PasswordBox x:Name="PwdInput" Grid.Row="1" Style="{DynamicResource FufuPasswordBox}" Height="36"
                                 KeyDown="TxtInput_KeyDown" Visibility="Collapsed"/>

                    <TextBlock x:Name="TxtError" Grid.Row="2" Text="" FontSize="12"
                               Foreground="{DynamicResource DangerBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                        <Button x:Name="BtnOk" Content="确定" Width="90" Style="{DynamicResource PrimaryButton}"
                                Margin="0,0,10,0" Click="BtnOk_Click" IsDefault="True"/>
                        <Button x:Name="BtnCancel" Content="取消" Width="90" Style="{DynamicResource SecondaryButton}"
                                Click="BtnCancel_Click" IsCancel="True"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
