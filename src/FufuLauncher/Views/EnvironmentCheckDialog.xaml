<Window x:Class="FufuLauncher.Views.EnvironmentCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FufuLauncher.Converters"
        Title="环境自检 — 可爱的芙芙"
        Width="520" Height="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Margin="10">
    <Border Style="{DynamicResource DialogRoot}" Padding="0"
            MouseLeftButtonDown="TitleBar_Drag">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>   <!-- 标题栏 -->
                <RowDefinition Height="*"/>     <!-- 检测列表 -->
                <RowDefinition Height="50"/>    <!-- 底部按钮 -->
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0">
                <TextBlock Text="🩺  环境自检结果" Foreground="{DynamicResource AppForeground}" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,8,0" Click="BtnClose_Click"
                        Style="{DynamicResource GhostButton}"/>
            </Grid>

            <!-- 检测项列表 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,4,16,4">
                <ItemsControl x:Name="ItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="6" Margin="0,0,0,6" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 状态图标 -->
                                    <TextBlock Grid.Column="0" Text="{Binding Status}"
                                               FontSize="16" VerticalAlignment="Center"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#66BB66"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="✗">
                                                        <Setter Property="Foreground" Value="#FF5555"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="⚠">
                                                        <Setter Property="Foreground" Value="#FFB347"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 名称 + 分级标识 + 详情 -->
                                    <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppForeground}"
                                                       FontSize="13" FontWeight="SemiBold"/>
                                            <Border CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding ShowSeverityLabel, Converter={x:Static conv:BoolToVisConverter.Instance}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#33FFB347"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCriticalFailure}" Value="True">
                                                                <Setter Property="Background" Value="#33FF5555"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding SeverityLabel}" FontSize="10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FFB347"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCriticalFailure}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FF5555"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- 下载按钮(仅失败项+有 URL 时显示) -->
                                    <Button Grid.Column="2" VerticalAlignment="Center"
                                            Tag="{Binding DownloadUrl}"
                                            Click="BtnDownload_Click"
                                            Cursor="Hand"
                                            Visibility="{Binding HasDownload, Converter={x:Static conv:BoolToVisConverter.Instance}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4"
                                                        Padding="10,5" Cursor="Hand">
                                                    <TextBlock Text="{Binding DownloadLabel}"
                                                               Foreground="White" FontSize="11"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 底部 -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <TextBlock x:Name="SummaryText" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"
                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="重新检测" Width="88" Height="32" Margin="0,0,8,0"
                                Style="{DynamicResource SecondaryButton}" Click="BtnRescan_Click"/>
                        <Button Content="确定" Width="88" Height="32"
                                Style="{DynamicResource PrimaryButton}" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
    </Border>
</Window>
