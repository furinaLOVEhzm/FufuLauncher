<!-- ModsPage.xaml — 模组管理(全新重写)
     可爱的芙芙
     读取当前游戏版本的 mods 目录(APP\mcGAME\mods\{实例});
     支持启用/禁用、删除、导入、拖拽导入、打开目录。在线下载请前往「在线市场」。 -->
<Page x:Class="FufuLauncher.Views.ModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="680" d:DesignWidth="1000"
      Loaded="Page_OnLoaded" AllowDrop="True" Drop="Page_OnDrop" DragOver="Page_OnDragOver">
    <Grid Margin="26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="2,0,0,12">
            <TextBlock Text="模组管理" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource AppForeground}"/>
            <TextBlock x:Name="TxtInstanceInfo" Text="请先选择一个游戏版本" FontSize="12" Opacity="0.6"
                       Foreground="{DynamicResource AppForeground}" Margin="1,4,0,0"/>
        </StackPanel>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="14,10" Margin="0,0,0,10">
            <DockPanel>
                <ComboBox x:Name="CbInstance" DockPanel.Dock="Left" Width="230"
                          Style="{DynamicResource FufuCombo}" SelectionChanged="CbInstance_SelectionChanged"/>
                <Button DockPanel.Dock="Right" Content="🔄 刷新" Style="{DynamicResource SecondaryButton}"
                        Click="Refresh_Click"/>
                <Button DockPanel.Dock="Right" Content="📂 打开目录" Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,8,0" Click="OpenFolder_Click"/>
                <Button DockPanel.Dock="Right" Content="➕ 导入模组" Style="{DynamicResource PrimaryButton}"
                        Margin="0,0,8,0" Click="ImportMod_Click"/>
                <TextBlock x:Name="TxtSummary" VerticalAlignment="Center" Margin="16,0,12,0" FontSize="12"
                           Opacity="0.65" Foreground="{DynamicResource AppForeground}"/>
            </DockPanel>
        </Border>

        <!-- 搜索 + 拖拽提示 -->
        <DockPanel Grid.Row="2" Margin="2,0,6,10">
            <TextBox x:Name="TxtSearch" DockPanel.Dock="Left" Width="260"
                     Style="{DynamicResource SearchBox}" Tag="搜索模组名称/文件名…"
                     TextChanged="TxtSearch_TextChanged"/>
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11"
                       Opacity="0.5" Foreground="{DynamicResource AppForeground}"
                       Text="支持直接拖拽 .jar 文件到窗口导入"/>
        </DockPanel>

        <!-- 模组列表 -->
        <Grid Grid.Row="3">
            <ListBox x:Name="ModList" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,6,8"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource Card}" Padding="16,12" Opacity="{Binding RowOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Display}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppForeground}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                        <Border Style="{DynamicResource MetaChip}" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding StateText}" FontSize="10" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding MetaText}" FontSize="11" Opacity="0.55"
                                               Foreground="{DynamicResource AppForeground}" Margin="1,5,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding ToggleText}" Style="{DynamicResource SecondaryButton}"
                                            Tag="{Binding}" Click="ToggleMod_Click"/>
                                    <Button Content="🗑" Style="{DynamicResource DangerButton}" Padding="10,6"
                                            Margin="8,0,0,0" Tag="{Binding}" Click="DeleteMod_Click"
                                            ToolTip="删除模组文件"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="TxtEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="12.5" Opacity="0.55" TextAlignment="Center"
                       Foreground="{DynamicResource AppForeground}"
                       Text="暂无模组&#10;可点击「导入模组」或前往「在线市场」下载安装"/>
        </Grid>
    </Grid>
</Page>
