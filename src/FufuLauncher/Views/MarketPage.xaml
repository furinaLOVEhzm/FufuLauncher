<!-- MarketPage.xaml — 在线市场(全新重写)
     可爱的芙芙
     基于 Modrinth 官方 API(快速失败 + 自动重试,不依赖第三方镜像)。
     支持模组/资源包/光影三类资源,按当前游戏版本与加载器筛选,一键安装到对应目录。 -->
<Page x:Class="FufuLauncher.Views.MarketPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="680" d:DesignWidth="1000"
      Loaded="Page_OnLoaded">
    <Grid Margin="26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="2,0,0,12">
            <TextBlock Text="在线市场" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource AppForeground}"/>
            <TextBlock x:Name="TxtApiInfo" Text="资源源:Modrinth 官方 API · 快速失败自动重试" FontSize="12" Opacity="0.6"
                       Foreground="{DynamicResource AppForeground}" Margin="1,4,0,0"/>
        </StackPanel>

        <!-- 分类切换 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,0,10">
            <RadioButton x:Name="RbMods" Content="🧩 模组" GroupName="MarketCat" IsChecked="True"
                         Style="{DynamicResource FilterRadio}" Checked="Category_Checked"/>
            <RadioButton x:Name="RbRespack" Content="🎨 资源包" GroupName="MarketCat"
                         Style="{DynamicResource FilterRadio}" Checked="Category_Checked"/>
            <RadioButton x:Name="RbShader" Content="✨ 光影" GroupName="MarketCat"
                         Style="{DynamicResource FilterRadio}" Checked="Category_Checked"/>
        </StackPanel>

        <!-- 搜索 + 筛选 -->
        <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="14,10" Margin="0,0,0,10">
            <DockPanel>
                <TextBox x:Name="TxtQuery" DockPanel.Dock="Left" Width="280"
                         Style="{DynamicResource SearchBox}" Tag="搜索名称或关键词…"
                         KeyDown="TxtQuery_KeyDown"/>
                <Button DockPanel.Dock="Left" Content="🔍 搜索" Style="{DynamicResource PrimaryButton}"
                        Margin="10,0,0,0" Click="Search_Click"/>
                <Button DockPanel.Dock="Right" Content="🔄 热门" Style="{DynamicResource SecondaryButton}"
                        Click="Hot_Click" ToolTip="按下载量加载热门资源"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <TextBlock Text="版本" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource AppForeground}"/>
                    <ComboBox x:Name="CbGameVersion" Width="110" Style="{DynamicResource FufuCombo}"/>
                    <TextBlock Text="加载器" FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                               Margin="12,0,6,0" Foreground="{DynamicResource AppForeground}"/>
                    <ComboBox x:Name="CbLoader" Width="110" Style="{DynamicResource FufuCombo}"/>
                </StackPanel>
                <TextBlock x:Name="TxtInstanceHint" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="11.5"
                           Opacity="0.6" Foreground="{DynamicResource AppForeground}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- 结果列表 -->
        <ListBox x:Name="ResultList" Grid.Row="3" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,6,8"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource Card}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 图标 -->
                            <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
                                <Border CornerRadius="9" Background="{DynamicResource SubtleFillBrush}">
                                    <TextBlock Text="📦" FontSize="19" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Border CornerRadius="9" ClipToBounds="True">
                                    <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </Grid>

                            <!-- 信息 -->
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppForeground}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                    <TextBlock Text="{Binding DownloadsDisplay}" FontSize="11" Opacity="0.55"
                                               Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center"
                                               Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" FontSize="11.5" Opacity="0.7" Margin="1,4,0,0"
                                           Foreground="{DynamicResource AppForeground}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding MetaText}" FontSize="10.5" Opacity="0.5" Margin="1,3,0,0"
                                           Foreground="{DynamicResource AppForeground}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- 安装按钮 -->
                            <Button Grid.Column="2" Content="⬇ 安装" Style="{DynamicResource PrimaryButton}"
                                    Tag="{Binding}" Click="Install_Click" VerticalAlignment="Center"
                                    IsEnabled="{Binding CanInstall}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 状态栏 -->
        <Border Grid.Row="4" Margin="2,10,6,4">
            <DockPanel>
                <ProgressBar x:Name="InstallProgress" DockPanel.Dock="Right" Width="180" Height="6"
                             Style="{DynamicResource FufuProgress}" VerticalAlignment="Center"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="TxtStatus" DockPanel.Dock="Left" FontSize="12" Opacity="0.7"
                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Text="就绪"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
