<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- 固定 win-x64,禁止 any-cpu/可移植 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 普通构建保持框架依赖;自包含/单文件开关仅在发布配置 FufuRelease.pubxml 中生效 -->
    <SelfContained>false</SelfContained>
    <LangVersion>latest</LangVersion>

    <!-- 程序集信息 -->
    <RootNamespace>FufuLauncher</RootNamespace>
    <AssemblyName>FufuLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- exe 文件版本资源元信息(只写入文件属性,不含数字签名) -->
    <Version>1.8.1.2</Version>
    <AssemblyVersion>1.8.1.2</AssemblyVersion>
    <FileVersion>1.8.1.2</FileVersion>
    <InformationalVersion>1.8.1.2</InformationalVersion>
    <Title>可爱的芙芙 MC-Java版启动器</Title>
    <Company>可爱的芙芙</Company>
    <Product>可爱的芙芙 Minecraft启动器</Product>
    <Copyright>Copyright © 可爱的芙芙</Copyright>
    <Description>可爱的芙芙 MC-Java版启动器</Description>
    <Authors>可爱的芙芙</Authors>
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>

  <!-- 将 C++ 原生 DLL 复制到输出目录(按当前配置/平台动态查找)
       注意:C++ DLL 需先用 VS2022 编译 native\FufuNative\FufuNative.vcxproj 产出 -->
  <ItemGroup>
    <None Include="..\..\native\FufuNative\$(Platform)\$(Configuration)\FufuNative.dll"
          Condition="Exists('..\..\native\FufuNative\$(Platform)\$(Configuration)\FufuNative.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>runtimes\win-x64\native\FufuNative.dll</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

</Project>
