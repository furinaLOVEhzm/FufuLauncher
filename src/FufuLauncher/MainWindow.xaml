<Window x:Class="FufuLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vms="clr-namespace:FufuLauncher.ViewModels"
        Title="可爱的芙芙 - Minecraft启动器"
        Width="1180" Height="760"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Loaded="MainWindow_OnLoaded">

    <Window.Resources>
        <!-- 侧边栏导航项模板(精致图标式):图标在上、小字在下,
             悬停淡入过渡 + 选中主题色胶囊高亮 -->
        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vms:NavItem}">
            <Button Tag="{Binding Key}" Click="NavItem_Click" Cursor="Hand"
                    Width="56" Height="52" Margin="0,2"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Focusable="False" ToolTip="{Binding Label}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 悬停层:半透明填充,透明度过渡动画 -->
                            <Border x:Name="HoverLayer" CornerRadius="10"
                                    Background="{DynamicResource SubtleFillBrush}" Opacity="0"/>
                            <!-- 选中层:主题色胶囊 -->
                            <Border x:Name="SelectedLayer" CornerRadius="10"
                                    Background="{DynamicResource PrimaryBrush}" Opacity="0"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="NavIcon" Text="{Binding Icon}" FontSize="17"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="NavLabel" Text="{Binding Label}" FontSize="9.5"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 鼠标悬停:150ms 淡入 / 200ms 淡出 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- 选中高亮 -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="SelectedLayer" Property="Opacity" Value="1"/>
                                <Setter TargetName="NavLabel" Property="Foreground" Value="White"/>
                                <Setter TargetName="NavLabel" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- 垂直排列面板模板 -->
        <ItemsPanelTemplate x:Key="VerticalPanel">
            <StackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>
    </Window.Resources>

    <!-- 外层圆角边框(统一窗口圆角 + 描边 + 阴影)-->
    <Border CornerRadius="10" BorderBrush="#66000000" BorderThickness="1">
        <Border.Background>
            <SolidColorBrush Color="#FF1E1E2E" Opacity="0.0"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="22" ShadowDepth="0" Direction="270"/>
        </Border.Effect>

        <Grid>
            <!-- 背景层:图片或视频(单层,Border圆角裁剪+ClipToBounds) -->
            <Border x:Name="BackgroundLayer" Panel.ZIndex="0"
                    CornerRadius="10" ClipToBounds="True"/>

            <!-- 半透明蒙版:增强前景可读性(颜色随主题,透明度由 ThemeService 动态控制)-->
            <Border x:Name="OverlayMaskBorder" Panel.ZIndex="0" Background="{DynamicResource OverlayTint}">
                <Border.OpacityMask>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Border Background="White" CornerRadius="10"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.OpacityMask>
            </Border>

            <!-- 主内容层 -->
            <Grid Panel.ZIndex="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>

                <!-- 标题栏(可拖动) -->
                <Grid Grid.Row="0" Background="{DynamicResource OverlayTint}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <!-- 标题栏小 Logo:优先加载专属 Logo(tupian\tub.png),失败时回退内置色块 -->
                        <Border x:Name="TitleLogoBox" Width="22" Height="22" CornerRadius="5"
                                Background="{DynamicResource LogoBrush}" ClipToBounds="True"
                                VerticalAlignment="Center">
                            <Image x:Name="TitleLogoImage" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="可爱的芙芙" Foreground="{DynamicResource AppForeground}"
                                     FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock Text="MINECRAFT LAUNCHER" Foreground="{DynamicResource SecondaryTextBrush}"
                                     FontSize="9" VerticalAlignment="Center" Margin="12,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnMinimize" Click="BtnMinimize_Click"
                                   Style="{DynamicResource TitleBarButton}" Content="—"/>
                        <Button x:Name="BtnMaximize" Click="BtnMaximize_Click"
                                   Style="{DynamicResource TitleBarButton}" Content="▢"/>
                        <Button x:Name="BtnClose" Click="BtnClose_Click"
                                   Style="{DynamicResource TitleBarCloseButton}"/>
                    </StackPanel>
                </Grid>

                <!-- 主体:左侧精致图标侧边栏 + 右侧内容区 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== 侧边栏(半透明 OverlayTint,不遮挡全局图片/视频背景) ===== -->
                    <Border Grid.Column="0" Background="{DynamicResource OverlayTint}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 顶部:品牌 Logo(可爱芙芙标识) -->
                            <Border Width="34" Height="34" CornerRadius="10" Margin="0,12,0,8"
                                    Background="{DynamicResource LogoBrush}" ClipToBounds="True"
                                    HorizontalAlignment="Center">
                                <Image x:Name="SidebarLogoImage" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <!-- 中部:主导航项(超出高度时垂直滚动) -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding NavVm.MainItems,
                                                            RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                              ItemTemplate="{StaticResource NavItemTemplate}"
                                              Margin="6,4,6,0"/>
                            </ScrollViewer>

                            <!-- 底部:日志/自检/设置/关于 -->
                            <StackPanel Grid.Row="2" Margin="6,2,6,10">
                                <Border Height="1" Background="{DynamicResource CardBorder}"
                                        Opacity="0.45" Margin="10,2,10,6"/>
                                <ItemsControl ItemsSource="{Binding NavVm.BottomItems,
                                                            RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                              ItemTemplate="{StaticResource NavItemTemplate}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 右侧内容区域:透明背景,让底层图片透出;只切换 Frame 内容,不重建主窗口 -->
                    <Border Grid.Column="1" Background="Transparent">
                        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
                    </Border>
                </Grid>

                <!-- 底部状态栏 -->
                <Border Grid.Row="2" Background="{DynamicResource OverlayTint}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="StatusBarText" Text="就绪"
                                         Foreground="{DynamicResource StatusTextBrush}" VerticalAlignment="Center"
                                         FontSize="11"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusRight" Grid.Column="1"
                                     Text="{Binding AppVersion, StringFormat=可爱的芙芙 \{0\}}"
                                     Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"
                                     Margin="0,0,12,0" FontSize="11"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
